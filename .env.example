# ---- Supabase: accounts and all tenant data (required) ----
# From your project dashboard: Project Settings > API.
#
# Use a project dedicated to this app. Supabase Auth is per-project, so sharing
# one with another app lets that app's users sign into this dashboard.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Anon / publishable key. Served to the browser by GET /api/public-config, and
# safe there: row-level security decides what a signed-in token can reach.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# service_role key. Bypasses row-level security entirely, so the server filters
# every query by user_id itself. Never expose it to a browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this deployment. Password-reset and email-confirmation links
# come back here, so it must match what you allow-list in
# Supabase > Authentication > URL Configuration (include /app/**).
PUBLIC_URL=http://localhost:3000

# ---- HTTP server ----
PORT=3000
HOST=0.0.0.0

# ---- WhatsApp sessions ----
# Root for per-tenant Baileys credentials: auth/tenants/<user-id>/.
# This whole tree is a pile of credentials -- keep it on a persistent disk and
# treat a backup of it like a password store.
AUTH_DIR=./auth

# Label included in webhook payloads.
SESSION_NAME=wa-http-api

# Maximum simultaneous WhatsApp sockets. This is the real capacity limit: each
# one is a live WebSocket plus its own Signal store. Past the cap, idle sessions
# are evicted and restart on next use.
MAX_TENANT_SESSIONS=25

# Resolve every recipient through onWhatsApp before sending. Leave this on: a
# number missing its country code otherwise produces a valid-looking JID that
# belongs to nobody, and WhatsApp silently drops the message.
VERIFY_RECIPIENT=true

# ---- Outgoing rate limit (per tenant) ----
# Minimum delay between two of one client's sends, in ms. Higher is safer.
SEND_DELAY_MS=3000
# Reject sends with 503 once this many of that client's messages are queued.
MAX_QUEUE_SIZE=500

# ---- Incoming messages -> webhook ----
# Optional. Inbound messages are always stored in Supabase; set this to also
# forward them to your own endpoint. Leave empty to disable.
WEBHOOK_URL=
# Sent as the x-webhook-secret header so your receiver can verify the caller.
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=3

# ---- Logging ----
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Pretty-print logs (nice locally, leave false in Docker so logs stay JSON).
LOG_PRETTY=false
