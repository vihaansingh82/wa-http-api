# ---- HTTP server ----
PORT=3000
HOST=0.0.0.0

# Shared secret required in the `x-api-key` header on every route except GET /health.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me-to-a-long-random-string

# ---- Baileys / session ----
# Folder that holds the multi-file auth state. Treat it like a password: it IS the session.
AUTH_DIR=./auth

# Name shown in WhatsApp > Linked devices
SESSION_NAME=wa-http-api

# ---- Outgoing rate limit ----
# Minimum delay between two outgoing sends, in ms. Higher is safer against bans.
SEND_DELAY_MS=3000
# Reject sends with 503 once this many messages are already queued.
MAX_QUEUE_SIZE=500

# ---- Incoming messages -> webhook ----
# Leave empty to disable webhook forwarding.
WEBHOOK_URL=
# Sent as the `x-webhook-secret` header so your receiver can verify the caller.
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=3

# ---- Logging ----
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Pretty-print logs (nice locally, leave false in Docker so logs stay JSON).
LOG_PRETTY=false
