# ---- HTTP server ----
PORT=3000
HOST=0.0.0.0

# Shared secret required in the `x-api-key` header on every route except GET /health.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me-to-a-long-random-string

# ---- Baileys / session ----
# Folder that holds the multi-file auth state. Treat it like a password: it IS the session.
AUTH_DIR=./auth

# Name shown in WhatsApp > Linked devices
SESSION_NAME=wa-http-api

# ---- Browser pairing / device tokens ----
# Where hashed device tokens are kept. Minted by the Link WhatsApp flow at /.
TOKEN_STORE=./data/tokens.json
# After a successful link, also DM the new token to your own WhatsApp chat so it
# lands on the phone. Set false if you would rather it never touch a chat log.
SEND_TOKEN_TO_PHONE=true
# How long a pairing attempt stays claimable (ms).
PAIR_CLAIM_TTL_MS=600000
# Pairing is only startable from this machine unless you set this true. Leave it
# false unless the server sits behind your own authentication.
ALLOW_REMOTE_PAIRING=false
# Treat a direct loopback connection as "the operator is at the machine", which
# is what lets the console pair with no credential locally. Forwarded requests
# (a proxy or tunnel) are already excluded automatically; set this false to drop
# the exemption entirely and always require the admin key to pair.
TRUST_LOOPBACK_PAIRING=true

# ---- Outgoing rate limit ----
# Resolve every recipient through onWhatsApp before sending. Leave this on: a
# number missing its country code otherwise produces a valid-looking JID that
# belongs to nobody, and WhatsApp silently drops the message.
VERIFY_RECIPIENT=true

# Minimum delay between two outgoing sends, in ms. Higher is safer against bans.
SEND_DELAY_MS=3000
# Reject sends with 503 once this many messages are already queued.
MAX_QUEUE_SIZE=500

# ---- Incoming messages -> webhook ----
# Leave empty to disable webhook forwarding.
WEBHOOK_URL=
# Sent as the `x-webhook-secret` header so your receiver can verify the caller.
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=3

# ---- Logging ----
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Pretty-print logs (nice locally, leave false in Docker so logs stay JSON).
LOG_PRETTY=false
